        {
          "from": 0.3,
          "to": 3.8,
          "text": "New on AshPhys: handwritten worked solutions"
        }
      ]
    },
    {
      "id": "problem",
      "type": "screens",
      "seconds": 5,
      "device": "browser",
      "shots": [
        {
          "capture": "a-question",
          "at": 0
