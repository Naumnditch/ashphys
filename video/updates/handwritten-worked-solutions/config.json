{
  "slug": "handwritten-worked-solutions",
  "title": "New: Handwritten Worked Solutions",
  "summary": "Get a practice question wrong and watch the full worked solution, written by hand by your teacher. Zoom in, pan around, go full screen.",
  "cta": {
    "label": "Try a practice question",
    "href": "/curriculum?c=a-level"
  },
  "fps": 30,
  "brand": {
    "logo": "brand/logo.png",
    "url": "ashphys.org",
    "font": "Inter",
    "colors": {
      "ink": "#111827",
      "muted": "#4b5563",
      "page": "#f9fafb",
      "surface": "#ffffff",
      "accent": "#2563eb",
      "accentSoft": "#dbeafe",
      "highlight": "#fde68a",
      "grid": "#dfe3ea"
    }
  },
  "showcase": {
    "A": {
      "questionIncludes": [
        "0.20 kg bob",
        "1.0 m string",
        "horizontal circle",
        "30°"
      ],
      "answer": "1.868"
    },
    "B": {
      "questionIncludes": [
        "Phobos",
        "9.38 × 10⁶ m",
        "2.76 × 10⁴ s",
        "mass of Mars"
      ],
      "answer": "6.412e23"
    }
  },
  "transition": {
    "type": "fade",
    "seconds": 0.4
  },
