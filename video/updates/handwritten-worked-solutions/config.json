          "strokes": [
            [
              88,
              92
            ],
            [
              229,
              233
            ]
          ]
        },
        {
          "label": "r = 0.5 m",
          "strokes": [
            [
              296,
              303
            ]
          ]
        },
        {
          "label": "T = 1.87 s",
          "strokes": [
            [
              363,
              373
            ]
          ]
        }
      ],
      "captions": [
        {
          "from": 0.2,
          "to": 4.5,
          "text": "Every step, written by hand, by your teacher"
