        {
          "at": 1.2,
          "target": "a-question:answerInput",
          "click": true
        },
        {
          "at": 2.0,
          "target": "a-typed:checkButton"
        },
        {
          "at": 2.4,
          "target": "a-typed:checkButton",
          "click": true
        },
        {
          "at": 3.6,
          "target": "a-feedback:openSolution"
