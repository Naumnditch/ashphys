{
  "name": "ashphys-video",
  "private": true,
  "description": "Announcement video pipeline for AshPhys: Playwright capture of the real site, Remotion composition, ffmpeg encodes. Separate workspace: nothing here is installed with the site or on Vercel.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "seed": "node scripts/seed-demo-db.mjs",
    "export-demo-data": "node scripts/export-demo-data.mjs",
    "capture": "node scripts/capture.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-alignment.mjs",
    "publish": "node scripts/publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "fetch-strokes": "node scripts/fetch-strokes.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "bcryptjs": "2.4.3",
    "perfect-freehand": "1.2.3",
    "pg": "8.16.3",
    "playwright-core": "1.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "roughjs": "4.6.6",
    "vara": "1.4.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.7",
    "typescript": "5.4.5",
    "vitest": "2.1.9"
  }
}
